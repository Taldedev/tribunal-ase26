# Copy this file to .env and put your own key in it.
# Get a key at https://openrouter.ai/keys
#
# For the deployed site this same variable is set in the Netlify UI under
# Site configuration -> Environment variables. The .env file is only for
# local development and is never committed.

OPENROUTER_API_KEY=sk-or-v1-replace-me

# Optional. OpenRouter shows these on your usage dashboard.
OPENROUTER_APP_URL=https://github.com/MeirBM/Tribunal.git
OPENROUTER_APP_TITLE=Tribunal
