# Copy this file to .env and put your own values in it.
#
# .env is gitignored. This file is committed, and it takes placeholders only:
# a real key pasted in here is published. That mistake has been made twice on
# this project, which is why the pre-commit hook scans for it rather than
# trusting anyone to remember.
#
# For the deployed site the same variables are set in the Netlify UI under
# Site configuration -> Environment variables. Functions read them at build
# time, not live, so a changed value does nothing until the site rebuilds.

# ---------------------------------------------------------------------------
# The model provider. Get a key at https://openrouter.ai/keys
# Free models still require an account and a key; they just do not charge for
# tokens.

OPENROUTER_API_KEY=sk-or-v1-replace-me

# Optional. OpenRouter shows these on your usage dashboard. Without them the
# function uses its own origin.
OPENROUTER_APP_URL=https://github.com/Taldedev/tribunal-ase26
OPENROUTER_APP_TITLE=Tribunal

# ---------------------------------------------------------------------------
# The record. Create a project at https://supabase.com, run supabase/schema.sql
# in its SQL editor, then take these two from Project Settings -> API.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security by design. It is read
# only inside netlify/functions/cases.js and must never reach a browser, a
# client-side variable, or a commit. Treat it exactly as you treat the model
# key: if it is ever committed, it is compromised and must be rotated rather
# than deleted.
#
# Without these two the app still runs and still deliberates. It simply does
# not keep anything, and says so on screen rather than pretending it did.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me-with-the-service-role-key

# Optional, and read by nothing in the application. `npm run check:record` uses
# it to prove row-level security is actually on: the service-role key bypasses
# RLS by design, so every check made with it would pass just as well against
# tables the whole internet can read. The anonymous (publishable) key is the
# one RLS applies to, and it is public by design - it ships inside any browser
# app that uses one - so it is safe here.
SUPABASE_ANON_KEY=replace-me-with-the-anon-or-publishable-key
